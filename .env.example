# ============================================
# Flask Configuration
# ============================================
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=True
HOST=0.0.0.0
PORT=5000

# ============================================
# Database Configuration (MSSQL)
# ============================================
DB_SERVER=localhost
DB_NAME=ChatBotDB
DB_USERNAME=sa
DB_PASSWORD=YourPassword123!
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_PORT=1433

# ============================================
# OpenAI API Configuration
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1000

# ============================================
# JWT Token Configuration
# ============================================
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# Document Configuration
# ============================================
DOCUMENTS_PATH=./documents
ENABLE_DOCUMENT_SEARCH=True
ENABLE_SP_SEARCH=True

# ============================================
# Chatbot Configuration
# ============================================
MAX_HISTORY_LENGTH=10

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FILE=chatbot.log

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGINS=*

# ============================================
# NOTLAR:
# ============================================
# 1. Bu dosyayı .env olarak kopyalayın
# 2. Tüm "your-*" değerlerini gerçek değerlerle değiştirin
# 3. OpenAI API key için: https://platform.openai.com/api-keys
# 4. Production'da DEBUG=False yapın
# 5. SECRET_KEY ve JWT_SECRET_KEY için güçlü rastgele değerler kullanın
# 6. .env dosyasını asla git'e commit etmeyin!
